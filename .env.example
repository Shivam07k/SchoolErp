# ---------------------------------------------------------------------------
# School ERP environment template
# Copy to .env for local development, or paste these values into Render.
# Never commit the real .env file.
# ---------------------------------------------------------------------------

NODE_ENV=production
PORT=3100

# Supabase PostgreSQL connection.
# Dashboard -> Project Settings -> Database -> Connection pooling.
# Use the SESSION pooler (port 5432), not the transaction pooler, because the
# app uses transactions and PostgreSQL advisory locks.
PG_HOST=aws-0-<region>.pooler.supabase.com
PG_PORT=5432
PG_USER=postgres.<project-ref>
PG_PASSWORD=<your-database-password>
PG_DATABASE=postgres
PG_SSL=true
PG_MAX=5
PG_MIN=0

# JWT signing secret. Must be at least 32 random characters.
# Render can generate this automatically (see render.yaml).
JWT_SECRET=replace-with-a-long-random-secret
JWT_TTL=24h

# Leave master-password login disabled in production.
# MASTER_PASSWORD=
# ALLOW_MASTER_PASSWORD=false

# The public URL of the Render service. Render supplies RENDER_EXTERNAL_URL
# automatically, so this can usually be left unset there.
CORS_ORIGIN=https://your-service.onrender.com

RATE_LIMIT_WINDOW_MS=60000
RATE_LIMIT_MAX=600
LOGIN_RATE_LIMIT_WINDOW_MS=900000
LOGIN_RATE_LIMIT_MAX=10

SQL_LOG=false

# Optional: store uploaded files in Supabase Storage instead of the ephemeral
# Render filesystem. Create a PRIVATE bucket first, then set all three values.
# SUPABASE_URL=https://<project-ref>.supabase.co
# SUPABASE_SERVICE_ROLE_KEY=<service-role-key>
# SUPABASE_STORAGE_BUCKET=school-uploads

# One-time bootstrap values used by server/scripts/db-migrate.mjs and
# server/scripts/seed-admin.mjs only. They are not required at runtime.
# ADMIN_PASSWORD=<initial-admin-password>
# COMPANY_NAME=School ERP
# SCHOOL_APP_ID=school_erp
